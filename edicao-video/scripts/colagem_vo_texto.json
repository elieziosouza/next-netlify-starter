[
 {
  "start": 0.09,
  "end": 2.28,
  "text": "O maior exército do Brasil não tem tanque."
 },
 {
  "start": 2.81,
  "end": 3.78,
  "text": "Não tem fuzil"
 },
 {
  "start": 4.28,
  "end": 6.6,
  "text": "e tem mais de 10 milhões de soldados."
 },
 {
  "start": 7.22,
  "end": 8.26,
  "text": "Quatro de outubro."
 },
 {
  "start": 8.76,
  "end": 9.45,
  "text": "Primeiro turno."
 },
 {
  "start": 9.98,
  "end": 12.07,
  "text": "Lula termina atrás de Flávio Bolsonaro."
 },
 {
  "start": 12.57,
  "end": 13.48,
  "text": "No dia seguinte,"
 },
 {
  "start": 13.72,
  "end": 16.52,
  "text": "um canal de WhatsApp vira central de mobilização."
 },
 {
  "start": 17.02,
  "end": 17.58,
  "text": "O nome:"
 },
 {
  "start": 17.82,
  "end": 18.98,
  "text": "Exército do Lula."
 },
 {
  "start": 19.48,
  "end": 20.17,
  "text": "O general:"
 },
 {
  "start": 20.44,
  "end": 21.54,
  "text": "André Janones."
 },
 {
  "start": 21.91,
  "end": 26.59,
  "text": "Em menos de dois dias, o canal sai de 50 mil para mais de um milhão de pessoas."
 },
 {
  "start": 27.06,
  "end": 27.66,
  "text": "O segredo?"
 },
 {
  "start": 28.22,
  "end": 29.22,
  "text": "Ele não pedia voto."
 },
 {
  "start": 29.69,
  "end": 30.76,
  "text": "Ele dava missões."
 },
 {
  "start": 31.22,
  "end": 32.42,
  "text": "Compartilha esse vídeo."
 },
 {
  "start": 32.89,
  "end": 34.18,
  "text": "Comenta naquele post."
 },
 {
  "start": 34.62,
  "end": 35.98,
  "text": "Traz mais gente pro canal."
 },
 {
  "start": 36.47,
  "end": 37.86,
  "text": "Aí veio o contra-ataque."
 },
 {
  "start": 38.1,
  "end": 40.49,
  "text": "A campanha de Flávio foi ao TSE"
 },
 {
  "start": 40.82,
  "end": 42.76,
  "text": "e no dia 11 o canal foi derrubado."
 },
 {
  "start": 43.32,
  "end": 44.3,
  "text": "No mesmo dia,"
 },
 {
  "start": 44.63,
  "end": 46.6,
  "text": "outro ministro mandou reativar."
 },
 {
  "start": 46.97,
  "end": 48.71,
  "text": "E cada tentativa de calar"
 },
 {
  "start": 48.92,
  "end": 49.83,
  "text": "virou propaganda."
 },
 {
  "start": 50.33,
  "end": 51.66,
  "text": "Depois do debate da Band,"
 },
 {
  "start": 51.99,
  "end": 55.02,
  "text": "Janones foi parar na UTI com arritmia."
 },
 {
  "start": 55.61,
  "end": 57.51,
  "text": "Saiu do hospital e voltou pra missão."
 },
 {
  "start": 58.07,
  "end": 59.34,
  "text": "25 de outubro."
 },
 {
  "start": 59.8,
  "end": 64.62,
  "text": "Lula reeleito com 51,79% dos votos."
 },
 {
  "start": 65.02,
  "end": 67.11,
  "text": "O canal passou de 10 milhões de pessoas."
 },
 {
  "start": 67.51,
  "end": 70.02,
  "text": "E Lula chamou Janones de general."
 },
 {
  "start": 70.62,
  "end": 73.19,
  "text": "Na minha opinião, essa eleição respondeu uma pergunta:"
 },
 {
  "start": 73.75,
  "end": 76.55,
  "text": "um canal de WhatsApp ajuda a eleger um presidente?"
 },
 {
  "start": 77.11,
  "end": 77.64,
  "text": "Ajuda."
 },
 {
  "start": 78.14,
  "end": 78.7,
  "text": "E você,"
 },
 {
  "start": 79.0,
  "end": 80.04,
  "text": "entrou pro exército?"
 },
 {
  "start": 80.38,
  "end": 81.03,
  "text": "Comenta aqui."
 }
]